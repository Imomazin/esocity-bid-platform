# Esocity Bid — environment template.
#
# Copy to .env.local for local development. NEVER commit real values: this repository is public.
# Every variable is optional. With DEMO_MODE=true and nothing else set, the full platform runs
# with simulated bidders, payments, email and deliveries (the recommended first Vercel deploy).
# See docs/VERCEL_DEPLOYMENT.md for the order in which to switch real services on.

# --- App -------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Esocity Bid
NEXT_PUBLIC_APP_URL=
# Set to true only on the production domain once launch-ready (robots.txt disallows otherwise).
ALLOW_INDEXING=false

# --- Mode ------------------------------------------------------------------------------------
# true: in-memory demo backend (no database required). false: production adapters (Phase 2+).
DEMO_MODE=true

# --- Persistence (Phase 2) -------------------------------------------------------------------
# PostgreSQL 15+. Local: docker compose up -d, then postgres://postgres@127.0.0.1:5432/esocity
DATABASE_URL=

# Upstash Redis (REST). When set, rate limits, idempotency keys and locks become distributed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Authentication (Phase 3) ----------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 32`. Required when DEMO_MODE=false.
AUTH_SECRET=

# --- Payments (Phase 3) ----------------------------------------------------------------------
# demo | stripe. Card details are only ever collected by the provider's hosted checkout.
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Real-time (Phase 4) ---------------------------------------------------------------------
# demo (polling) | ably
REALTIME_PROVIDER=demo
ABLY_API_KEY=

# --- Email -----------------------------------------------------------------------------------
# demo (logged, never sent) | resend
EMAIL_PROVIDER=demo
RESEND_API_KEY=
EMAIL_FROM=

# --- Object storage --------------------------------------------------------------------------
# demo (generated artwork) | vercel-blob | s3
STORAGE_PROVIDER=demo

# --- Market ----------------------------------------------------------------------------------
# UK is the launch market. IE and US are placeholders with paid-bid mechanics disabled pending
# legal review (docs/COMPLIANCE.md).
MARKET_REGION=UK
DEFAULT_CURRENCY=GBP

# --- Platform controls -----------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Comma-separated overrides, e.g. "referrals=true,drops=false" (see src/lib/config/flags.ts).
FEATURE_FLAGS=
# debug | info | warn | error
LOG_LEVEL=info
